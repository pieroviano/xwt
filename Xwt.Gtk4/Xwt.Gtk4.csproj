<Project Sdk="Microsoft.NET.Sdk">

  <!-- Native GTK 4 backend for Xwt (GtkSharp4 bindings). Xwt.Gtk (GTK 2) is a separate backend. -->
  <PropertyGroup>
    <TargetFramework>net472</TargetFramework>
    <TargetFrameworks></TargetFrameworks>
    <AssemblyName>Xwt.Gtk4</AssemblyName>
    <RootNamespace>Xwt.GtkBackend</RootNamespace>
    <GenerateAssemblyInfo>false</GenerateAssemblyInfo>
    <SignAssembly>true</SignAssembly>
    <AssemblyOriginatorKeyFile>..\xwt.snk</AssemblyOriginatorKeyFile>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <LangVersion>9</LangVersion>
    <!-- 0612/0618: GTK 4 deprecates TreeView/ComboBox/CellRenderer & co., which Xwt still maps to -->
    <NoWarn>$(NoWarn);0612;0618</NoWarn>
    <GtkSharp4Version Condition="'$(GtkSharp4Version)' == ''">4.22.4.*</GtkSharp4Version>
  </PropertyGroup>

  <PropertyGroup Condition=" '$(Configuration)' == 'Debug' ">
    <DebugType>full</DebugType>
  </PropertyGroup>
  <PropertyGroup Condition=" '$(Configuration)' == 'Release' ">
    <DebugSymbols>true</DebugSymbols>
    <DebugType>pdbonly</DebugType>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="GtkSharp4" Version="$(GtkSharp4Version)" />
    <PackageReference Include="GdkSharp4" Version="$(GtkSharp4Version)" />
    <PackageReference Include="GskSharp4" Version="$(GtkSharp4Version)" />
    <PackageReference Include="GLibSharp4" Version="$(GtkSharp4Version)" />
    <PackageReference Include="GioSharp4" Version="$(GtkSharp4Version)" />
    <PackageReference Include="PangoSharp4" Version="$(GtkSharp4Version)" />
    <PackageReference Include="CairoSharp4" Version="$(GtkSharp4Version)" />
    <PackageReference Include="GrapheneSharp4" Version="$(GtkSharp4Version)" />
  </ItemGroup>

  <ItemGroup>
    <Reference Include="System.Drawing" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Xwt\Xwt.csproj" />
  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource Include="icons\searchbox-clear-16.png" LogicalName="searchbox-clear-16.png" />
    <EmbeddedResource Include="icons\searchbox-clear-16@2x.png" LogicalName="searchbox-clear-16@2x.png" />
    <EmbeddedResource Include="icons\searchbox-clear-16~dark.png" LogicalName="searchbox-clear-16~dark.png" />
    <EmbeddedResource Include="icons\searchbox-clear-16~dark@2x.png" LogicalName="searchbox-clear-16~dark@2x.png" />
    <EmbeddedResource Include="icons\searchbox-search-16.png" LogicalName="searchbox-search-16.png" />
    <EmbeddedResource Include="icons\searchbox-search-16@2x.png" LogicalName="searchbox-search-16@2x.png" />
    <EmbeddedResource Include="icons\searchbox-search-16~dark.png" LogicalName="searchbox-search-16~dark.png" />
    <EmbeddedResource Include="icons\searchbox-search-16~dark@2x.png" LogicalName="searchbox-search-16~dark@2x.png" />
  </ItemGroup>

</Project>
